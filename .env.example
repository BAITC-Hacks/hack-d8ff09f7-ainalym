# Ainalym — параметры окружения (скопируйте в .env.local; значения ключей никогда не коммитятся)
# Режим приложения: live | offline | qualified_external (пусто = автоматически: live при наличии ключей)
AINALYM_MODE=
# Провайдер типизированных решений: jev (TypeSafe напрямую → Vercel AI Gateway как резерв) | openai | rules (детерминированные правила без LLM) | offline (воспроизведение записанных решений, только для тестов)
AI_PROVIDER=
# Jev: прямой ключ TypeSafe (основной) и ключ Vercel AI Gateway (резерв)
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# OpenAI: черновики, объяснения, голос (Realtime); совместимые провайдеры — через OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=   # оставьте пустым или удалите строку, если используете api.openai.com
# NVIDIA (необязательно): тот же OpenAI-совместимый адаптер через базовый URL
NVIDIA_API_KEY=
# База данных SQLite (файл создаётся автоматически; тесты используют :memory:)
DATABASE_PATH=./data/ainalym.db
# Фоновый воркер: 0 отключает интервал (по умолчанию включён); автовоспроизведение ленты событий: 1 включает
AINALYM_WORKER=
AINALYM_FEED_AUTOPLAY=
# Хостинг демо: код доступа и дневной лимит живых вызовов провайдера (пусто = без ограничений)
DEMO_ACCESS_CODE=
DEMO_DAILY_LIVE_CALLS=
# доступ к тестовому API каталога партнёра
EKT_API_USER=
EKT_API_PASSWORD=
